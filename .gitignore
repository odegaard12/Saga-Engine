# ── Frontend ─────────────────────────────────────────────────────────────────
# Lo construido no se guarda: lo genera el Dockerfile con `npm run build`, y
# tener además una copia en el repositorio son dos verdades sobre lo mismo
# (la del repositorio no es nunca la que se sirve).
frontend/dist/
frontend/node_modules/
frontend/src/*.bak.*
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo
frontend/.vite/
frontend/vite.config.ts.timestamp-*.mjs
.husky/

# Ninguna distribución de Node dentro del repositorio: son 85 MB que paga
# cada clon para siempre. Si hace falta Node en Windows, se instala en Windows.
node-v*/

# sim/playwright-bench: arnés de pruebas con navegadores de verdad. node_modules
# se instala local (playwright descarga además ~300 MB de navegadores, ver su
# README), y las capturas de cada corrida son evidencia de UNA prueba, no algo
# que versionar.
sim/playwright-bench/node_modules/
sim/playwright-bench/out/
sim/playwright-bench/out/*.png
sim/playwright-bench/out/m4/

# ── Sistema y editor ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
