# Required in normal use
ADMIN_PASS=PUT_A_REAL_PASSWORD_HERE
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Mission password: one shared word for the whole group. It closes the player
# entrance -/api/config stops handing out the player list and /api/game refuses
# to mint a session until the player unlocks with /api/mission/unlock. The real
# value is stored hashed in data/mission_auth.json and is changed from the admin
# panel (Settings). This variable is only the initial seed: if there is no
# stored password yet, the first start takes it from here. Leave empty to keep
# the gate off (public engine works exactly as before).
MISSION_PASS=

# Set to 1 only for local development if you intentionally want
# the app to allow the fallback password CHANGE_ME
ALLOW_DEFAULT_ADMIN=0
SAGA_ENABLE_API_DOCS=0
# Trusted proxy headers
# Keep disabled unless SAGA runs behind a trusted reverse proxy/tunnel.
# When disabled, SAGA ignores X-Forwarded-For / CF-Connecting-IP and uses the direct client address.
# IMPORTANT: behind a Cloudflare tunnel / reverse proxy every request arrives with
# the proxy's IP. The admin-login lockout is per-IP, so with this at 0 five failed
# logins from anyone lock out the real admin (trivial DoS). Set it to 1 and list
# the proxy IP in TRUSTED_PROXY_IPS (e.g. 127.0.0.1) so CF-Connecting-IP is used.
TRUST_PROXY_HEADERS=0
# Comma-separated proxy IPs allowed to provide real client headers, for example 127.0.0.1 when a local tunnel/reverse proxy terminates requests.
TRUSTED_PROXY_IPS=
# Optional comma-separated CIDR ranges for trusted proxies.
TRUSTED_PROXY_CIDRS=
SAGA_CORS_ALLOW_ORIGINS=

# Storage backend: sqlite (default, what production runs) or json (legacy files).
SAGA_STORAGE_BACKEND=sqlite
# Optional custom SQLite file path (default: <SAGA_DATA_DIR>/saga.sqlite3).
SAGA_SQLITE_DB=

# HTTPS and request defences (see backend/app/security/peticiones.py)
# Behind a tunnel that terminates TLS the app sees plain HTTP. With
# TRUST_PROXY_HEADERS=1 + TRUSTED_PROXY_IPS it trusts X-Forwarded-Proto; set this
# to 1 to always mark cookies Secure and send HSTS (production is always HTTPS).
SAGA_FORCE_HTTPS=0
# Writes (POST/DELETE to /api/) from another web origin are refused (CSRF).
# Extra allowed origins, comma-separated (e.g. https://game.example.org). 0 disables the check.
SAGA_ALLOWED_ORIGINS=
SAGA_CSRF_CHECK=1
# Body size caps (bytes) and writes per minute per client IP.
SAGA_MAX_BODY_BYTES=2097152
SAGA_MAX_ADMIN_BODY_BYTES=67108864
SAGA_WRITE_RATE_PER_MINUTE=600

# Weather in the mission area (GET /api/tiempo; see backend/app/runtime/integraciones/tiempo.py).
# 0 turns it off completely (the phone then shows nothing).
SAGA_TIEMPO=1
# Optional own weather station: URL of a MeteoCatoira-style /api/weather JSON
# (temp, wind, gust, wind_deg, rain_rate, data_age_sec). Only set it if the
# station is in the mission area. Empty = not used.
SAGA_TIEMPO_URL=
# Open-Meteo forecast for the mission centre (hourly + 15 min rain). 0 disables it.
SAGA_TIEMPO_OPENMETEO=1
# Alternative Open-Meteo-compatible endpoint (empty = the public API).
SAGA_TIEMPO_OPENMETEO_URL=

# Organiser alerts by ntfy (see backend/app/runtime/integraciones/avisos.py).
# Nothing is sent unless URL and topic are set AND they are switched on in the
# admin panel (Settings -> Alerts), which is off by default.
SAGA_NTFY_URL=
SAGA_NTFY_TOPIC=
# Only if the topic needs it (Bearer access token). Never commit it.
SAGA_NTFY_TOKEN=
