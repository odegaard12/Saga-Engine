# Required in normal use
ADMIN_PASS=PUT_A_REAL_PASSWORD_HERE
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Mission password: one shared word for the whole group. It closes the player
# entrance -/api/config stops handing out the player list and /api/game refuses
# to mint a session until the player unlocks with /api/mission/unlock. The real
# value is stored hashed in data/mission_auth.json and is changed from the admin
# panel (Settings). This variable is only the initial seed: if there is no
# stored password yet, the first start takes it from here. Leave empty to keep
# the gate off (public engine works exactly as before).
MISSION_PASS=

# Set to 1 only for local development if you intentionally want
# the app to allow the fallback password CHANGE_ME
ALLOW_DEFAULT_ADMIN=0
SAGA_ENABLE_API_DOCS=0
# Trusted proxy headers
# Keep disabled unless SAGA runs behind a trusted reverse proxy/tunnel.
# When disabled, SAGA ignores X-Forwarded-For / CF-Connecting-IP and uses the direct client address.
# IMPORTANT: behind a Cloudflare tunnel / reverse proxy every request arrives with
# the proxy's IP. The admin-login lockout is per-IP, so with this at 0 five failed
# logins from anyone lock out the real admin (trivial DoS). Set it to 1 and list
# the proxy IP in TRUSTED_PROXY_IPS (e.g. 127.0.0.1) so CF-Connecting-IP is used.
TRUST_PROXY_HEADERS=0
# Comma-separated proxy IPs allowed to provide real client headers, for example 127.0.0.1 when a local tunnel/reverse proxy terminates requests.
TRUSTED_PROXY_IPS=
# Optional comma-separated CIDR ranges for trusted proxies.
TRUSTED_PROXY_CIDRS=
SAGA_CORS_ALLOW_ORIGINS=

# Storage backend
# JSON remains the active default. SQLite is currently a tested foundation for future migration.
SAGA_STORAGE_BACKEND=json
# Optional custom SQLite file path for future storage backend work.
SAGA_SQLITE_DB=
