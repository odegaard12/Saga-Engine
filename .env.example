# Required in normal use
ADMIN_PASS=PUT_A_REAL_PASSWORD_HERE

# Set to 1 only for local development if you intentionally want
# the app to allow the fallback password CHANGE_ME
ALLOW_DEFAULT_ADMIN=0
# Trusted proxy headers
# Keep disabled unless SAGA runs behind a trusted reverse proxy/tunnel.
# When disabled, SAGA ignores X-Forwarded-For / CF-Connecting-IP and uses the direct client address.
TRUST_PROXY_HEADERS=0
# Comma-separated proxy IPs allowed to provide real client headers, for example 127.0.0.1 when a local tunnel/reverse proxy terminates requests.
TRUSTED_PROXY_IPS=
# Optional comma-separated CIDR ranges for trusted proxies.
TRUSTED_PROXY_CIDRS=

# Storage backend
# JSON remains the active default. SQLite is currently a tested foundation for future migration.
SAGA_STORAGE_BACKEND=json
# Optional custom SQLite file path for future storage backend work.
SAGA_SQLITE_DB=
